{
  "name": "stammtisch",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted notebook for your friends: who they are, what you did together, what you have planned",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test \"server/*.test.js\" \"server/kit/*.test.js\"",
    "icons": "node scripts/make-icons.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  }
}
