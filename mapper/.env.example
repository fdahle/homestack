# Secret used to sign JWT tokens. Must be at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Port the API server listens on (default: 3000). Docker always uses 3000 inside the container.
PORT=3000

# Set to "production" in production environments.
# Affects: cookie Secure flag (sign-in then requires HTTPS), HSTS, error log verbosity.
NODE_ENV=production

# Number of reverse proxies in front of the app (default: 1), "false" when there is none, or a list of
# trusted proxy addresses such as "loopback, 10.0.0.0/8". Used for the client IP in rate limits; never
# set it while the app port is reachable without the proxy, or clients can fake their IP.
# TRUST_PROXY=1

# Docker Compose only: host address the app port (3063) is published on (default: 127.0.0.1).
# Change it only when the reverse proxy runs on another host or in another container.
# BIND_ADDRESS=127.0.0.1

# Without Docker only: path of the SQLite database (default: data/mapper.db in the project folder).
# Docker always uses /app/data/mapper.db, which is ./data/mapper.db on the host.
# MAPPER_DB_PATH=/var/lib/mapper/mapper.db
