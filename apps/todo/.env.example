# Copy to .env

# Your account, created on the first start
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Deleted tasks can be brought back (undo) for this many days, then they're gone for good
TRASH_DAYS=7

# Behind Authelia instead of the own account (see kit/README.md#login)
# AUTH_PROXY_SECRET=

# Reminders: due dates and times are this time zone's
TZ=Europe/Berlin

# PORT=3073
