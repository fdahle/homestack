# Copy to .env

# Your account, created on the first start
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Push reminders (birthdays, plans, friends you haven't seen) go out once a day from this hour on
REMINDER_HOUR=9
# A contact address for the browsers' push services, mailto: or https:
VAPID_SUBJECT=mailto:you@example.com

PORT=3068
TZ=Europe/Berlin
