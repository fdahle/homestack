{
  "name": "notizbuch",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted notes that work offline: Markdown with checklists, labels, pictures and files, kept in step across your devices",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/*.test.js\" \"server/kit/*.test.js\" \"web/src/lib/*.test.js\"",
    "icons": "node scripts/make-icons.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "tiptap-markdown": "^0.9.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  }
}
