{
  "name": "stapel",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted tracker for your comic collection: what you own, what you have read, what is missing",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "icons": "node scripts/make-icons.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "barcode-detector": "^3.2.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  }
}
