COUCHDB_USER=admin
COUCHDB_PASSWORD=password
ENCRYPTION_ENABLED=false
ALLOW_SIGNUP=true
VITE_DEBUG=false

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Client build — set VITE_VAPID_PUBLIC_KEY to the same value as VAPID_PUBLIC_KEY
# OR leave it empty to let the client fetch it at runtime from GET /api/push/vapid-key
VITE_VAPID_PUBLIC_KEY=
