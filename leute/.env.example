# Copy to .env

# Your account, created on the first start
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Push reminders (birthdays, plans, friends you haven't seen) go out once a day from this hour on
REMINDER_HOUR=9
# A contact address for the browsers' push services, mailto: or https:
VAPID_SUBJECT=mailto:you@example.com

PORT=3068
TZ=Europe/Berlin

# Optional: log in through Authelia instead (see design/README.md). Leave empty for the own account.
AUTH_PROXY_SECRET=

# Optional: Fernweh shows your friends on its map (README.md#fernweh).
# LINK_TOKEN: a shared secret (openssl rand -hex 32), the same as LEUTE_LINK_TOKEN in Fernweh's .env.
# FERNWEH_URL: Fernweh's address, for the "Auf der Karte" link on a friend's page.
LINK_TOKEN=
FERNWEH_URL=
