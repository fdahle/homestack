# Copy to .env

# The first account, created on the first start. Add more people in the app's settings.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Strongly recommended: a free account at https://www.comics.org/accounts/register/
# Without it, GCD blocks requests after about 50 per hour.
GCD_EMAIL=
GCD_PASSWORD=

PORT=3067
TZ=Europe/Berlin
