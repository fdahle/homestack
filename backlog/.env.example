# Copy to .env and change the password
APP_PASSWORD=change-me-to-something-long

# How often every blog is rescanned
SCAN_INTERVAL_HOURS=12

# Languages you read; Discover skips blogs in other languages
READ_LANGUAGES=en,de

# Optional: enables "Ask Claude" on the Discover page (roughly 5–10 cents per request, only when you press it)
ANTHROPIC_API_KEY=

TZ=Europe/Berlin
