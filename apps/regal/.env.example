# Copy to .env

# Your account, created on the first start
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Books come from Open Library (no key needed). Google Books fills in what Open Library
# lacks (German editions, covers, descriptions); it works without a key, but the keyless
# quota is shared and often used up. A key: https://console.cloud.google.com → APIs →
# "Books API" → Credentials → API key.
GOOGLE_BOOKS_API_KEY=

# Calibre: the library folder (the one with metadata.db). With Docker it is mounted
# read-only at /calibre by docker-compose.override.yml (see the README), so leave
# CALIBRE_LIBRARY empty here. Without Docker (npm start), set the folder here.
#CALIBRE_LIBRARY=/srv/calibre/library
# How often Regal reads the library, in hours (also once at every start)
CALIBRE_SYNC_HOURS=6
# Your Calibre-Web, for "In Calibre-Web öffnen" on each book (without a trailing slash)
CALIBRE_WEB_URL=

PORT=3072
TZ=Europe/Berlin

# Optional: log in through Authelia instead (see kit/README.md). Leave empty for the own account.
AUTH_PROXY_SECRET=
