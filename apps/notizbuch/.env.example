# Copy to .env

# Your account, created on the first start
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Largest picture or file you can attach to a note, in MB (nginx's client_max_body_size must allow it)
MAX_FILE_MB=25
# All of one account's files together
MAX_USER_MB=2048

# Days a note stays in the trash before it is deleted for good
TRASH_DAYS=30

# Behind Authelia instead of the own account (see kit/README.md#login)
# AUTH_PROXY_SECRET=

# PORT=3070
