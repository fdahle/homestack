# Copy to .env

# Your account, created on the first start
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Game search and covers come from IGDB. Register an application at
# https://dev.twitch.tv/console/apps (OAuth redirect: http://localhost, category: Website Integration)
# and copy its Client ID and a new Client Secret here.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: your Steam library (see the README). A Web API key from
# https://steamcommunity.com/dev/apikey and your Steam ID: the long number, or the name in your
# profile's address (steamcommunity.com/id/<name>). The game details on your profile must be public.
STEAM_API_KEY=
STEAM_ID=
# How often the library is read (0: only at start and from the Steam page)
STEAM_SYNC_HOURS=6

PORT=3069
TZ=Europe/Berlin

# Optional: log in through Authelia instead (see kit/README.md). Leave empty for the own account.
AUTH_PROXY_SECRET=
