COUCHDB_USER=admin
COUCHDB_PASSWORD=password
ENCRYPTION_ENABLED=false
# Public registration (off by default). Sign-ups never grant admin.
ALLOW_SIGNUP=false
VITE_DEBUG=false

# Admin account — created with the admin role on API startup if that username
# doesn't exist yet. Never overwrites an existing user; you can clear
# ADMIN_PASSWORD once the account exists. Password: at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Client build — set VITE_VAPID_PUBLIC_KEY to the same value as VAPID_PUBLIC_KEY
# OR leave it empty to let the client fetch it at runtime from GET /api/push/vapid-key
VITE_VAPID_PUBLIC_KEY=
