# Copy to .env

# Your account, created on the first start
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Film and series data come from TMDB. Create a (free) account at https://www.themoviedb.org,
# then Settings → API: copy the "API Read Access Token" here (or the older "API Key" as TMDB_API_KEY).
TMDB_TOKEN=
TMDB_API_KEY=
# Titles, genres and descriptions in this language (English when TMDB has no German text)
TMDB_LANGUAGE=de-DE
# Where to stream: the country whose streaming services are shown
WATCH_REGION=DE

PORT=3071
TZ=Europe/Berlin

# Optional: log in through Authelia instead (see kit/README.md). Leave empty for the own account.
AUTH_PROXY_SECRET=
