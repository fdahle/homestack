# Copy to .env

# The first account, created on the first start. Add more people in the app's settings.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Strongly recommended: a free account at https://www.comics.org/accounts/register/
# Without it, GCD blocks requests after about 50 per hour.
GCD_EMAIL=
GCD_PASSWORD=

# Covers come from Comic Vine. Get a free API key at https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=

# Details load in the background, at most this many GCD requests an hour
# (your searches count too). Default: 25 without an account, 100 with one.
# GCD_BACKGROUND_PER_HOUR=25

PORT=3067
TZ=Europe/Berlin
