# Copy to .env next to docker-compose.yml

# Required: a long random value (openssl rand -hex 32). nginx sends the same one along as
# X-Stammbaum-Proxy (deploy/nginx-stammbaum.conf); the server answers nobody else and does
# not start without it.
STAMMBAUM_PROXY_SECRET=

# Who may edit: Authelia logins, comma-separated, e.g. felix,oma. Everyone else in the
# family group only reads. Empty means EVERYONE who can log in may edit — set it.
STAMMBAUM_EDITORS=

# 1 (or true, yes, on) makes the family read-only for everyone
STAMMBAUM_READONLY=

# How much photos/ may hold, in MB; uploads past it are turned away
STAMMBAUM_MAX_PHOTOS_MB=2048

PORT=3065
# Whose files the server writes in data/: yours (id -u, id -g)
STAMMBAUM_UID=1000
STAMMBAUM_GID=1000
