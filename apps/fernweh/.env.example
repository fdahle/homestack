# Secret used to sign JWT tokens. Must be at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Port the API server listens on without Docker, and the host port Docker Compose publishes (default: 3063).
# Docker always uses 3000 inside the container.
PORT=3063

# Set to "production" in production environments.
# Affects: cookie Secure flag (sign-in then requires HTTPS), HSTS, error log verbosity.
NODE_ENV=production

# Number of reverse proxies in front of the app, "false" when there is none, or a list of trusted proxy
# addresses such as "loopback, 10.0.0.0/8". Default: false without Docker, 1 with Docker Compose. Used for
# the client IP in rate limits; never set it while the app port is reachable without the proxy, or clients
# can fake their IP. Behind nginx without Docker, set it to 1.
# TRUST_PROXY=1

# Docker Compose only: host address the app port (PORT, 3063) is published on (default: 127.0.0.1).
# Change it only when the reverse proxy runs on another host or in another container.
# BIND_ADDRESS=127.0.0.1

# Without Docker only: path of the SQLite database (default: data/mapper.db in the project folder).
# Docker always uses /app/data/mapper.db, which is ./data/mapper.db on the host.
# MAPPER_DB_PATH=/var/lib/mapper/mapper.db

# Sign in through the homestack login (Authelia) instead of Fernweh's own password: the same secret as in
# nginx's X-Auth-Proxy-Secret header (deploy/places.fdahle.de.conf). Requests without it get a 403.
# AUTH_PROXY_SECRET=

# Friends and their addresses from Leute (README.md#friends-from-leute). Off while LEUTE_URL or
# LEUTE_LINK_TOKEN is empty. LEUTE_URL is the server-to-server address over the shared Docker network,
# LEUTE_PUBLIC_URL the one in the browser (for "Open in Leute" links).
# LEUTE_URL=http://leute:3000
# LEUTE_LINK_TOKEN=
# LEUTE_PUBLIC_URL=https://friends.fdahle.de
# LEUTE_SYNC_HOURS=6
