{
  "name": "stammbaum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stammbaum — a pocket who-is-who for family gatherings",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr server/main.ts --outDir dist-server",
    "build:single": "tsc --noEmit && vite build --mode single",
    "start": "node dist-server/main.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "country-flag-emoji-polyfill": "^0.1.8",
    "vue": "^3.5.46"
  },
  "engines": {
    "node": ">=24"
  }
}
